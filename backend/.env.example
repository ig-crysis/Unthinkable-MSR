# Groq API key — free, get one at https://console.groq.com (no card required)
GROQ_API_KEY=your_groq_api_key_here

# Database (SQLite by default; swap to a Postgres URL later with no code changes)
DATABASE_URL=sqlite:///./app.db

# Where uploaded audio files are stored on disk
UPLOAD_DIR=./uploads

# Max accepted upload size, in megabytes
MAX_UPLOAD_MB=200

# A meeting crossing either threshold is routed through chunked processing
# (and requires user confirmation before it starts). Optional — defaults shown.
# CHUNK_SIZE_THRESHOLD_MB=20
# CHUNK_DURATION_THRESHOLD_MIN=15
