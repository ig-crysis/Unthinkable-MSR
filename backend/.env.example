# Groq API key — free, get one at https://console.groq.com (no card required)
GROQ_API_KEY=your_groq_api_key_here

# Optional: a second Groq account's key, used only for diarization batch
# calls so that workload has its own separate rate-limit budget instead of
# competing with summarization for the same account's. Leave unset to use
# GROQ_API_KEY for everything.
# GROQ_API_KEY_DIARIZE=your_second_groq_api_key_here

# Database (SQLite by default; swap to a Postgres URL later with no code changes)
DATABASE_URL=sqlite:///./app.db

# Where uploaded audio files are stored on disk
UPLOAD_DIR=./uploads

# Max accepted upload size, in megabytes
MAX_UPLOAD_MB=200

# A meeting crossing either threshold is routed through chunked processing
# (and requires user confirmation before it starts). Optional — defaults shown.
# CHUNK_SIZE_THRESHOLD_MB=20
# CHUNK_DURATION_THRESHOLD_MIN=15

# Set true when served over HTTPS (production) so the per-visitor ownership
# cookie is only ever sent encrypted. Leave false for local http dev.
# COOKIE_SECURE=true
